@startuml 05_secuencia_autenticar
title Diagrama de Secuencia - CU Autenticar Usuario
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Cliente
participant "<u>:PantallaCajero</u>" as PC
participant "<u>:SucursalDB</u>" as SDB
participant "<u>:CentralDB</u>" as CDB

Cliente -> PC : InsertarTarjeta(numero, vencimiento)
activate PC
PC -> SDB : ValidarTarjeta(numero, vencimiento)
activate SDB
SDB --> PC : //estadoTarjeta//
deactivate SDB
PC --> Cliente : //solicitudPin//
deactivate PC

Cliente -> PC : IngresarPin(pin)
activate PC
PC -> CDB : ValidarPin(numeroTarjeta, pinEncriptado)
activate CDB
CDB --> PC : //confirmacionPin//
deactivate CDB
PC --> Cliente : //menuOperaciones//
deactivate PC
@enduml
