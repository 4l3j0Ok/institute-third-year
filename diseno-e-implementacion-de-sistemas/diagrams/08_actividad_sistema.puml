@startuml 08_actividad_sistema
title Diagrama de Actividad - Sistema Cajero Automático (completo)
skinparam shadowing false
skinparam ArrowColor black
skinparam swimlaneWidth 190

|Cliente|
start
:Insertar tarjeta;
|Cajero|
:Leer datos de la tarjeta;
:Enviar datos de la tarjeta;
|Sucursal|
:Validar estado de la tarjeta;
|Cajero|
if (¿Tarjeta válida?) then ([sí])
  :Inicializar contador de intentos;
  repeat
    :Solicitar PIN;
    |Cliente|
    :Ingresar PIN;
    |Cajero|
    :Enviar PIN encriptado;
    |Red Central|
    :Validar PIN;
    |Cajero|
    if (¿PIN correcto?) then ([sí])
    else ([no])
      :Incrementar contador de intentos;
      :Mostrar error de PIN;
    endif
  repeat while (¿PIN incorrecto e intentos < 3?) is ([sí]) not ([no])
  if (¿PIN correcto?) then ([sí])
    repeat
      :Mostrar menú de operaciones;
      |Cliente|
      :Elegir operación;
      |Cajero|
      switch (¿Operación elegida?)
      case ([Consultar saldo])
        :Solicitar saldo;
        |Red Central|
        :Recuperar saldo disponible y total;
        |Cajero|
        :Mostrar saldo disponible, saldo total y fecha y hora;
        :Registrar consulta en el log de la sesión;
      case ([Extraer efectivo])
        :Solicitar monto a retirar;
        :Leer monto ingresado;
        :Solicitar autorización de débito;
        |Red Central|
        :Verificar saldo y límite diario, y debitar monto;
        |Cajero|
        if (¿Débito autorizado?) then ([sí])
          :Dispensar efectivo;
          :Registrar extracción en el log de la sesión;
          :Mostrar operación exitosa y saldo restante;
        else ([no])
          :Mostrar motivo del rechazo;
        endif
      case ([Transferir])
        repeat
          :Solicitar CBU destino;
          :Leer CBU destino ingresado;
          :Validar formato del CBU;
        backward:Mostrar error de CBU;
        repeat while (¿CBU inválido?) is ([sí]) not ([no])
        :Solicitar monto a transferir;
        :Leer monto ingresado;
        :Mostrar resumen y solicitar confirmación;
        :Leer confirmación del cliente;
        if (¿Cliente confirma?) then ([sí])
          :Enviar instrucción de transferencia;
          |Red Central|
          :Ejecutar transferencia;
          |Cajero|
          if (¿Transferencia ejecutada?) then ([sí])
            :Mostrar comprobante de transferencia;
            :Registrar transferencia en el log de la sesión;
          else ([no])
            :Mostrar motivo del rechazo;
          endif
        else ([no])
          :Cancelar transferencia;
        endif
      endswitch
      :Mostrar opciones "Otra operación" o "Finalizar";
    repeat while (¿Realizar otra operación?) is ([sí]) not ([no])
    if (¿Desea comprobante?) then ([sí])
      :Imprimir ticket de la sesión;
    else ([no])
    endif
  else ([no])
    :Bloquear tarjeta;
    :Informar bloqueo de la tarjeta;
  endif
else ([no])
  :Informar tarjeta bloqueada o vencida;
endif
:Devolver tarjeta;
:Cerrar sesión y eliminar datos de autenticación;
stop

legend right
  Los rombos sin texto son fusiones de alternativa:
  reúnen las ramas de una bifurcación o abren un bucle.
endlegend
@enduml
