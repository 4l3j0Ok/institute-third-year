@startuml 05_secuencia_autenticar
title Diagrama de Secuencia - CU Autenticar Usuario
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Cliente
participant "<u>:FormCajero</u>" as PC
participant "<u>:SucursalDB</u>" as SDB
participant "<u>:CentralDB</u>" as CDB

note over PC : :FormCajero es la :PantallaCajero de la consigna

Cliente -> PC : InsertarTarjeta(numero, fechaVencimiento)
activate PC
PC -> SDB : ValidarTarjeta(numero, fechaVencimiento)
activate SDB
SDB --> PC : //estadoTarjeta//
deactivate SDB
PC --> Cliente : //solicitudPin//
deactivate PC

Cliente -> PC : Autenticar(pin)
activate PC
PC -> CDB : ValidarPin(numeroTarjeta, pin)
activate CDB
CDB --> PC : //confirmacionPin//
deactivate CDB
PC --> Cliente : //menuOperaciones//
deactivate PC
@enduml
