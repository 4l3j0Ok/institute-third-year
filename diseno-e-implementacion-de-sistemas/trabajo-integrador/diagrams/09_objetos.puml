@startuml 09_objetos
title Diagrama de Objetos - Sesión con una consulta y una extracción
skinparam shadowing false

object "<u>sesion1 : Sesion</u>" as sesion1 {
  _estado = Operando
  _horaInicio = 14/11/2026 10:32
}

object "<u>cliente1 : Cliente</u>" as cliente1 {
  _nombre = "Cliente Demo"
  _dni = "30111222"
}

object "<u>tarjeta1 : Tarjeta</u>" as tarjeta1 {
  _numero = "1234567890123456"
  _fechaVencimiento = 31/12/2030
  _estado = Valida
  _intentosPin = 0
}

object "<u>cuenta1 : Cuenta</u>" as cuenta1 {
  _cbu = "0170099920000012345678"
  _saldoDisponible = 140000,00
  _saldoTotal = 140000,00
}

object "<u>consulta1 : Consulta</u>" as consulta1 {
  _monto = 0,00
  _fechaHora = 14/11/2026 10:33
  _numeroReferencia = ""
}

object "<u>extraccion1 : Extraccion</u>" as extraccion1 {
  _monto = 10000,00
  _fechaHora = 14/11/2026 10:34
  _numeroReferencia = "TX48213907"
}

sesion1 --> cliente1 : atiende
sesion1 --> tarjeta1 : usa
sesion1 --> cuenta1 : opera sobre
sesion1 *-- consulta1 : registra
sesion1 *-- extraccion1 : registra
consulta1 --> tarjeta1 : identifica con
consulta1 --> cuenta1 : afecta
extraccion1 --> tarjeta1 : identifica con
extraccion1 --> cuenta1 : afecta
@enduml
