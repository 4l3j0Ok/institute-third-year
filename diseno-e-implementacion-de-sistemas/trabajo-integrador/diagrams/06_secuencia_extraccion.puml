@startuml 06_secuencia_extraccion
title Diagrama de Secuencia - CU Extraer Efectivo
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Cliente
participant "<u>:FormCajero</u>" as PC
participant "<u>:CentralDB</u>" as CDB

note over PC : :FormCajero es la :PantallaCajero de la consigna

Cliente -> PC : SeleccionarOperacion("Extraer efectivo")
activate PC
PC --> Cliente : //solicitudMonto//
deactivate PC

Cliente -> PC : IngresarMonto(monto)
activate PC
PC -> CDB : AutorizarDebito(numeroTarjeta, monto)
activate CDB
CDB --> PC : //autorizacionDebito(numeroTransaccion, saldoRestante)//
deactivate CDB
PC -> PC : DispensarEfectivo(monto)
PC -> PC : RegistrarOperacion(numeroTransaccion)
PC --> Cliente : //operacionExitosa(saldoRestante)//
deactivate PC
@enduml
