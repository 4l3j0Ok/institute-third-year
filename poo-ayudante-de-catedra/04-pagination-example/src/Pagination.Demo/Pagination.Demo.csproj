<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Asocia cada *.Designer.cs con su *.cs para que Visual Studio habilite el botón
         "Ver diseñador" y anide el archivo en el Explorador de soluciones. -->
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ClienteEditForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ClienteEditForm.Designer.cs">
      <DependentUpon>ClienteEditForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Views\UserControls\Paginator.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\UserControls\Paginator.Designer.cs">
      <DependentUpon>Paginator.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
